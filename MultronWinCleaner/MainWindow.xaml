                                                            <DockPanel>
                                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,10,0"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanFix}"
                                                                          ToolTip="Fix this setting"/>
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <Border Background="{Binding SeverityColor}" CornerRadius="4" Padding="6,1" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0">
                                                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding DetailsText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding ActionText}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="DuplicateResultsPanel" Visibility="Collapsed" Margin="0,0,0,20" Padding="16,12"
                                                    CornerRadius="10" BorderThickness="1" BorderBrush="#66E67E22" Background="#14E67E22">
                                                <DockPanel>
                                                    <Grid Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Ellipse x:Name="DuplicateResultsIcon" Fill="#FFE67E22"/>
                                                        <TextBlock Text="⧉" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Button x:Name="DuplicateCancelButton" DockPanel.Dock="Right" Content="✕" ToolTip="Cancel the duplicate file search" Style="{StaticResource ResetButtonStyle}"
                                                            Width="32" Height="32" Padding="0" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                            Visibility="Collapsed" Click="DuplicateCancelButton_Click"/>
                                                    <Button x:Name="DuplicateResultsButton" DockPanel.Dock="Right" Content="Show Files" Style="{StaticResource ResetButtonStyle}"
                                                            Padding="14,6" FontSize="12" VerticalAlignment="Center" Click="DuplicateResultsButton_Click"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Duplicate Files" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock x:Name="DuplicateResultsStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                                                <Label Content="Search for directory:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextForeground}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Grid Margin="0,0,16,0">
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
                                                </Grid>
                                                <Button Content="Select All" Click="SelectAll_AllGroups_Click" Style="{StaticResource ModernButtonStyle}" Background="#FF0078D4" Foreground="White" Margin="0,0,8,0" />
                                                <Button Content="Unselect All" Click="UnselectAll_AllGroups_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" />
                                            </StackPanel>

                                            <DataGrid Name="dataGridGroups" ItemsSource="{Binding Groups}" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsReadOnly="True" HeadersVisibility="Column" RowDetailsVisibilityMode="Visible" AutoGenerateColumns="False" Foreground="{DynamicResource TextForeground}">
                                                <DataGrid.Resources>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </Style>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="0" Visibility="Collapsed" />
                                                </DataGrid.Columns>
                                                <DataGrid.RowDetailsTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="False" Background="Transparent" Foreground="{DynamicResource TextForeground}" Header="{Binding ExpanderHeader}">
                                                            <StackPanel Margin="16,8">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                    <Button Content="Select All" Click="SelectAll_Click" Tag="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="#FF0078D4" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
                                                                    <Button Content="Unselect All" Click="UnselectAll_Click" Tag="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Padding="12,6"/>
                                                                </StackPanel>
                                                                <ScrollViewer Name="ListBoxScroll" Height="180" Background="Transparent" ScrollChanged="FilesListBox_ScrollChanged">
                                                                    <ListBox ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0">
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,4" Foreground="{DynamicResource TextForeground}" Checked="CheckBox2_Checked" Unchecked="CheckBox2_Unchecked">
                                                                                    <CheckBox.ContextMenu>
                                                                                        <ContextMenu>
                                                                                            <MenuItem Header="Open file location" Click="OpenFileLocation_Click"/>
                                                                                            <MenuItem Header="Copy path" Click="CopyPath_Click"/>
                                                                                            <MenuItem Header="Always skip this file (add to Exceptions)" Click="AddToExceptions_Click"/>
                                                                                        </ContextMenu>
                                                                                    </CheckBox.ContextMenu>
                                                                                </CheckBox>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </DataGrid.RowDetailsTemplate>
                                            </DataGrid>
                                        </StackPanel>
                                    </ScrollViewer>
 
                                    <ScrollViewer x:Name="ScrollViewerDirectories" Panel.ZIndex="1" Background="{DynamicResource PanelBackground}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="wrapPanelDirectories" Orientation="Vertical" Margin="10" />
                                    </ScrollViewer>
                                    
                                    <Grid x:Name="ScrollViewerDetectedFiles" Panel.ZIndex="0" Visibility="Visible" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <WrapPanel Grid.Row="0" Margin="0,0,0,20">
                                            <Button x:Name="SlctAll" Content="Select All" Click="SelectAll_wpanel_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#FF0078D4" Foreground="White" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="UnScl" Content="Unselect All" Click="UnselectAll_wpanel_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="SaveSettings" Content="Save Selections" Click="SaveSettings_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#FF28A745" Foreground="White" Margin="0,0,10,10" Padding="16,10" ToolTip="Saves your choices to selections.txt. They are kept when the database is updated." />
                                            <Button x:Name="ApplySelections" Content="Write Selections to Database" Click="ApplySelectionsToDatabase_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" ToolTip="Optional: writes your saved choices into database.txt. They are lost when a newer database is downloaded." />
                                            <Button x:Name="ResetSelections" Content="Reset Selections" Click="ResetSelections_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="#FFDC3545" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" ToolTip="Deletes selections.txt so every entry goes back to its default from the database." />
                                            <Button x:Name="ReloadDb" Content="Reload Database" Click="ReloadDatabase_Click" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,10" Padding="16,10" />
                                        </WrapPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                                            <StackPanel x:Name="wrapPanel1" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                        </ScrollViewer>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
