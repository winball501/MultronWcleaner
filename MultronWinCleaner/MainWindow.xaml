<Window x:Class="Multron_Win_Cleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Multron Win Cleaner"
        Height="700" Width="900"
        MinWidth="600" MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"  
        AllowsTransparency="True"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        FontFamily="Segoe UI Variable">
    <Window.Background>
        <DynamicResource ResourceKey="WindowBackground"/>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="ExpanderGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="False"
                          Background="Transparent"
                          Foreground="{DynamicResource TextForeground}"
                          Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" >

                                    <TextBlock Text="{Binding Name}" />

                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <CollectionViewSource x:Key="GroupedProcesses"
                              Source="{Binding FlatLockedFiles}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="FilePath" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <DropShadowEffect x:Key="DropShadowSoft"
                          Color="{StaticResource DropShadowColor}"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.25" />

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFB33A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE05555" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFAA3A3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFFF8C00" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFA500" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFDC7633" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundScanButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Content" Value="Scan"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="55" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircularProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Ellipse Stroke="#FFC0C0C0" StrokeThickness="15" />
                            <Path x:Name="PART_Indicator" Stroke="#FF0078D7" StrokeThickness="15"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Show" Click="OpenApp_Click"/>
            <MenuItem Header="Hide" Click="HideApp_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="ExitApp_Click"/>
        </ContextMenu>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBorder" 
                                    CornerRadius="12" 
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource ButtonForeground}"
                                    BorderThickness="1"
                                    Width="50" Height="25"/>
                            <Ellipse x:Name="SwitchKnob"
                                     Fill="{DynamicResource ButtonForeground}"
                                     Width="21" Height="21" Margin="2"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="{DynamicResource ButtonForeground}"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="{DynamicResource ButtonForeground}"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Multron Win Cleaner"
                        MenuActivation="RightClick"
                        IconSource="pack://application:,,,/MultronWinCleaner;component/mwc_icon.ico"

                        ContextMenu="{StaticResource TrayMenu}" Margin="0,0,28,0" />

        <DockPanel Background="{DynamicResource PanelBackground}" Height="56" VerticalAlignment="Top" LastChildFill="False" MouseDown="TopBar_MouseDown">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="🧼 Multron Win Cleaner" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text=" v1.20.8 beta" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="8,6,0,0" VerticalAlignment="Top" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ToggleButton x:Name="ToggleThemeSwitch"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ToggleThemeSwitch_Checked"
                                  Unchecked="ToggleThemeSwitch_Unchecked" />
                    <TextBlock Text="Dark Mode" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <Button Content="⚙" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="OpenSettings_Click" ToolTip="Settings" Margin="0,0,6,0"/>
                <Button Content="🛠" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="UtilitiesButton_Click" ToolTip="Utilities" Margin="0,0,6,0"/>
                <Button Content="─" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MinimizeButton_Click" ToolTip="Minimize" Margin="0,0,6,0"/>
                <Button x:Name="buttonMaximize" Content="⤢" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MaximizeButton_Click" ToolTip="Maximize/Restore" Margin="0,0,6,0"/>
                <Button Content="✕" Style="{StaticResource DangerButtonStyle}" Width="30" Height="30" FontSize="14" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="28,72,28,28" Background="{DynamicResource PanelBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                <Grid Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 12">
                    <Ellipse Width="250" Height="250" Stroke="{DynamicResource ButtonBackground}" StrokeThickness="15" />

                    <ProgressBar x:Name="progressBar1"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Width="250"
                     Height="250"
                     Background="Transparent"
                     Foreground="{DynamicResource ButtonForeground}"
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     Style="{StaticResource CircularProgressBarStyle}" />

                    <Button x:Name="buttonStartScan"
                Style="{StaticResource RoundScanButtonStyle}"
                Width="110" Height="110"
                FontSize="20"
                Content="Scan"
                Click="ButtonStartScan_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0" Width="280">
                    <TextBlock x:Name="label1_Copy"
                   Text="Ready to scan"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="16"
                   FontWeight="Medium"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
                </ScrollViewer>
                <Button x:Name="ButtonLockedFiles"
            Style="{StaticResource ResetButtonStyle}"
            Width="202"
            Height="40"
            FontSize="16"
            Content="🔒 Show Locked Files."
            Click="ButtonLocked_Click"
            Visibility="Hidden"
            ToolTip="Show Locked Files." />
                <Button x:Name="buttonReset"
                        Style="{StaticResource ResetButtonStyle}"
                        Width="150"
                        Height="40"
                        FontSize="16"
                        Content="🔄 Reset"
                        Click="ButtonReset_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,20,0,0"
                        Visibility="Hidden"
                        ToolTip="Show Locked Files." />

            </StackPanel>


            <DockPanel Name="Panel" Grid.Column="1" LastChildFill="True" Margin="20,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="33*"/>
                        <RowDefinition Height="167*"/>
                    </Grid.RowDefinitions>

                    <Grid Background="{DynamicResource PanelBackground}" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <TextBlock Text="Locked Files"
               FontSize="18"
               FontWeight="Bold"
               Foreground="{DynamicResource TextForeground}"
               Margin="0,0,0,10" />

                        <TextBlock Text="These files are currently locked by other processes. Be careful when selecting."
               Grid.Row="1"
               TextWrapping="Wrap"
               FontSize="13"
               Foreground="{DynamicResource TextForeground}"
               Margin="0,0,0,10" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">

                            <StackPanel Margin="0,0,10,0">
                                <TextBox Name="ProcessBox"
                     Width="200"
                     TextChanged="ProcessBox_TextChanged"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by process name"
                     Background="{DynamicResource PanelBackground}"
                     Foreground="{DynamicResource TextForeground}"
                     Padding="5"
                     BorderThickness="1"
                     BorderBrush="Gray"
                     FontSize="14"/>
                                <TextBlock Text="Search Process..."
                       Name="SearchPText"
                       IsHitTestVisible="False"
                       Foreground="Gray"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBox Name="SearchBox"
                     Width="200"
                     TextChanged="SearchBox_TextChanged"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by file path"
                     Background="{DynamicResource PanelBackground}"
                     Foreground="{DynamicResource TextForeground}"
                     Padding="5"
                     BorderThickness="1"
                     BorderBrush="Gray"
                     FontSize="14"/>
                                <TextBlock Text="Search File Or Group..."
                       Name="SearchText"
                       IsHitTestVisible="False"
                       Foreground="Gray"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2"
                  Margin="0,60,0,0"
                  Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  ScrollChanged="MainScrollViewer_ScrollChanged"
                  Padding="0">
                            <ListBox x:Name="listBoxProcesses"
         Background="Transparent"
         BorderThickness="0"
         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="True" 
                                          BorderThickness="0" 
                                          Margin="0,10,0,5"
                                          Background="#1E1E1E">
                                                                <Expander.Header>
                                                                    <Border Background="#2D2D30" 
                                                Padding="10,8"
                                                CornerRadius="4">
                                                                        <TextBlock Text="{Binding Name}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold" 
                                                       Foreground="#3794FF"/>
                                                                    </Border>
                                                                </Expander.Header>
                                                                <Border BorderBrush="#3E3E42" 
                                            BorderThickness="1,0,0,0" 
                                            Margin="10,5,0,0">
                                                                    <ItemsPresenter Margin="15,5,0,5"/>
                                                                </Border>
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,3">
                                            <!-- Dosya yolu -->
                                            <TextBlock Text="{Binding FilePath}" 
                           Foreground="#E0E0E0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,3"/>
                                            <!-- Process checkbox -->
                                            <CheckBox Content="{Binding DisplayName}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Foreground="#B0B0B0"
                          FontSize="11"
                          Margin="20,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer x:Name="ScrollViewerDirectories"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto"
              Visibility="Collapsed"
              Padding="8"
              Background="{DynamicResource PanelBackground}"
              CanContentScroll="False"
              ClipToBounds="True"
              Panel.ZIndex="1" Grid.RowSpan="2">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel x:Name="wrapPanelDirectories"
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer Name="Datagridscroll"
              VerticalScrollBarVisibility="Auto"
              Visibility="Collapsed"
              HorizontalScrollBarVisibility="Auto"
              CanContentScroll="False" 
              Panel.ZIndex="99"
              Background="{DynamicResource PanelBackground}" Grid.RowSpan="2">

                        <StackPanel Orientation="Vertical">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                <Label Content="Search for directory" 
           FontWeight="Bold" 
           Foreground="{DynamicResource TextForeground}"
           Padding="2"
           VerticalAlignment="Center"
           Margin="0,0,10,0"/>
                                <TextBox Width="200"
             HorizontalAlignment="Left"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Search by path"
             Background="{DynamicResource PanelBackground}"
             Foreground="{DynamicResource TextForeground}"
             Padding="5"
             BorderThickness="1"
             BorderBrush="Gray"
             TextChanged="TextBox_TextChanged"
             FontSize="14"
             VerticalAlignment="Center"
             Margin="0,0,10,0"/>
                                <Button Content="Select All"
            Padding="10,4"
            Margin="0,0,10,0"
            Click="SelectAll_AllGroups_Click"
            VerticalAlignment="Center"
            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
            Background="{DynamicResource ButtonBackground}"
            Foreground="{DynamicResource ButtonForeground}"
            BorderBrush="{DynamicResource ButtonBorderBrush}"
            BorderThickness="1"
            FontWeight="SemiBold"
            MinWidth="100"
            Cursor="Hand"/>

                                <Button Content="Unselect All"
            Padding="10,4"
            Click="UnselectAll_AllGroups_Click"
            VerticalAlignment="Center"
            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
            Background="{DynamicResource ButtonBackground}"
            Foreground="{DynamicResource ButtonForeground}"
            BorderBrush="{DynamicResource ButtonBorderBrush}"
            BorderThickness="1"
            FontWeight="SemiBold"
            MinWidth="100"
            Cursor="Hand"/>
                            </StackPanel>

                            <DataGrid Name="dataGridGroups"
                  ItemsSource="{Binding Groups}"
                  CanUserAddRows="False"
                  Background="Transparent"
                  BorderThickness="0"
                  RowHeaderWidth="0"
                  Margin="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowDetailsVisibilityMode="Visible"
                  AutoGenerateColumns="False"
                  Foreground="{DynamicResource TextForeground}">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Path"
                                    Binding="{Binding Path}"
                                    Width="0"
                                    Visibility="Collapsed" />
                                </DataGrid.Columns>

                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="False"
                              Background="Transparent"
                              Foreground="{DynamicResource TextForeground}"
                              Header="{Binding ExpanderHeader}">

                                            <Expander.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextForeground}"
                                           Background="Transparent"
                                           FontWeight="Bold"
                                           Padding="4"/>
                                                </DataTemplate>
                                            </Expander.HeaderTemplate>


                                            <StackPanel>


                                                <StackPanel Orientation="Horizontal" Margin="5,0,0,5" HorizontalAlignment="Left">
                                                    <Button Content="Select All"
            Margin="0,0,10,0"
            Padding="10,4"
            Click="SelectAll_Click"
            Tag="{Binding}"
            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
            Background="{DynamicResource ButtonBackground}"
            Foreground="{DynamicResource ButtonForeground}"
            BorderBrush="{DynamicResource ButtonBorderBrush}"
            BorderThickness="1"
            FontWeight="SemiBold"
            MinWidth="100"
            Cursor="Hand" />

                                                    <Button Content="Unselect All"
            Padding="10,4"
            Click="UnselectAll_Click"
            Tag="{Binding}"
            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
            Background="{DynamicResource ButtonBackground}"
            Foreground="{DynamicResource ButtonForeground}"
            BorderBrush="{DynamicResource ButtonBorderBrush}"
            BorderThickness="1"
            FontWeight="SemiBold"
            MinWidth="100"
            Cursor="Hand" />
                                                </StackPanel>

                                                <ScrollViewer Name="ListBoxScroll"
                                          Height="150"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource PanelBackground}"
                                          Foreground="{DynamicResource TextForeground}"
                                          ScrollChanged="FilesListBox_ScrollChanged">

                                                    <ListBox ItemsSource="{Binding Files}"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         BorderThickness="0"
                                         Background="{DynamicResource PanelBackground}"
                                         Foreground="{DynamicResource TextForeground}">

                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding FileName}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="5,2" 
                                                      Foreground="{DynamicResource TextForeground}"
                                                      Checked="CheckBox2_Checked"
                                                      Unchecked="CheckBox2_Unchecked"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>

                                            </StackPanel>

                                        </Expander>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>


                    <ScrollViewer x:Name="ScrollViewerDetectedFiles"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto"
              Visibility="Visible"
              Padding="8"
              Background="{DynamicResource PanelBackground}"
              ClipToBounds="True"
              Grid.RowSpan="2">

                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="SlctAll"
        Content="Select All"
        Padding="10,4"
        Click="SelectAll_wpanel_Click"
        Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
        Background="{DynamicResource ButtonBackground}"
        Foreground="{DynamicResource ButtonForeground}"
        BorderBrush="{DynamicResource ButtonBorderBrush}"
        BorderThickness="1"
        FontWeight="SemiBold"
        MinWidth="100"
        Cursor="Hand"/>
                                <Button x:Name="UnScl"
            Content="Unselect All"
            Padding="10,4"
            Margin="0,0,10,0"
            Click="UnselectAll_wpanel_Click"
            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
