<Window x:Class="Multron_Win_Cleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Multron Win Cleaner"
        Height="700" Width="900"
        MinWidth="600" MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"  
        AllowsTransparency="True"
        
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        FontFamily="Segoe UI Variable">
    <Window.Background>
        <DynamicResource ResourceKey="WindowBackground"/>
    </Window.Background>
    <Window.Resources>
        
        <DropShadowEffect x:Key="DropShadowSoft"
                          Color="{StaticResource DropShadowColor}"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.25" />

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFB33A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE05555" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFAA3A3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundScanButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Content" Value="Scan"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="55" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircularProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Ellipse Stroke="#FFC0C0C0" StrokeThickness="15" />
                            <Path x:Name="PART_Indicator" Stroke="#FF0078D7" StrokeThickness="15"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Show" Click="OpenApp_Click"/>
            <MenuItem Header="Hide" Click="HideApp_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="ExitApp_Click"/>
        </ContextMenu>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBorder" 
                                    CornerRadius="12" 
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource ButtonForeground}"
                                    BorderThickness="1"
                                    Width="50" Height="25"/>
                            <Ellipse x:Name="SwitchKnob"
                                     Fill="{DynamicResource ButtonForeground}"
                                     Width="21" Height="21" Margin="2"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="{DynamicResource ButtonForeground}"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="{DynamicResource ButtonForeground}"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Multron Win Cleaner"
                        MenuActivation="RightClick"
                        IconSource="/favicon(1).ico"
                        ContextMenu="{StaticResource TrayMenu}" />

        <DockPanel Background="{DynamicResource PanelBackground}" Height="56" VerticalAlignment="Top" LastChildFill="False" MouseDown="TopBar_MouseDown">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="🧼 Multron Win Cleaner" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text=" v1.14.4 beta" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="8,6,0,0" VerticalAlignment="Top" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ToggleButton x:Name="ToggleThemeSwitch"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ToggleThemeSwitch_Checked"
                                  Unchecked="ToggleThemeSwitch_Unchecked" />
                    <TextBlock Text="Dark Mode" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
                <Button Content="⚙" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="OpenSettings_Click" ToolTip="Settings" Margin="0,0,6,0"/>
                <Button Content="🛠" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="UtilitiesButton_Click" ToolTip="Utilities" Margin="0,0,6,0"/>
                <Button Content="─" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MinimizeButton_Click" ToolTip="Minimize" Margin="0,0,6,0"/>
                <Button x:Name="buttonMaximize" Content="⤢" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MaximizeButton_Click" ToolTip="Maximize/Restore" Margin="0,0,6,0"/>
                <Button Content="✕" Style="{StaticResource DangerButtonStyle}" Width="30" Height="30" FontSize="14" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="28,72,28,28" Background="{DynamicResource PanelBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                <Grid Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 12">
                    <Ellipse Width="250" Height="250" Stroke="{DynamicResource ButtonBackground}" StrokeThickness="15" />

                    <ProgressBar x:Name="progressBar1"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Width="250"
                     Height="250"
                     Background="Transparent"
                     Foreground="{DynamicResource ButtonForeground}"
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     Style="{StaticResource CircularProgressBarStyle}" />

                    <Button x:Name="buttonStartScan"
                Style="{StaticResource RoundScanButtonStyle}"
                Width="110" Height="110"
                FontSize="20"
                Content="Scan"
                Click="ButtonStartScan_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
                </Grid>
 
                <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0" Width="280">
                    <TextBlock x:Name="label1_Copy"
                   Text="Ready to scan"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="16"
                   FontWeight="Medium"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>


            <DockPanel Grid.Column="1" LastChildFill="True" Margin="20,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                  
                    <ScrollViewer x:Name="ScrollViewerDirectories"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Visibility="Collapsed"  
                      Margin="0"
                      Padding="8"
                      Background="{DynamicResource PanelBackground}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      CanContentScroll="False"
                      ClipToBounds="True"
                      Panel.ZIndex="1">
                     
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel x:Name="wrapPanelDirectories"
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                        </Grid>
                    </ScrollViewer>
 
                    <ScrollViewer x:Name="ScrollViewerDetectedFiles"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Visibility="Visible"  
                      Margin="0"
                      Padding="8"
                      Background="{DynamicResource PanelBackground}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      CanContentScroll="False"
                      ClipToBounds="True"
                      Panel.ZIndex="0">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel x:Name="wrapPanel1"
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
