<Window x:Class="MultronWinCleaner.Duplicate_File_Finder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Duplicate File Finder"
        Height="600" Width="900"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid Margin="0,0,0,10">

        <DockPanel Background="{DynamicResource PanelBackground}" Height="56" VerticalAlignment="Top" LastChildFill="False" MouseDown="TopBar_MouseDown">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="📁 Multron Duplicate File Finder" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />

            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">

                <Button Content="─" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MinimizeButton_Click" ToolTip="Minimize" Margin="0,0,6,0"/>
                <Button x:Name="buttonMaximize" Content="⤢" Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MaximizeButton_Click" ToolTip="Maximize/Restore" Margin="0,0,6,0"/>
                <Button Content="✕" Style="{StaticResource DangerButtonStyle}" Width="30" Height="30" FontSize="14" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </DockPanel>


        <Grid Margin="20,50,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Grid.Column="0" Margin="0,23,15,-13">
                <StackPanel Margin="15">
                    <TextBlock Text="Scan Directory:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource Text}"/>
                    <ListBox x:Name="FolderListBox" Height="100" Background="{DynamicResource TextBoxBackground}" 
                             BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource Text}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                          
                            <ColumnDefinition Width="Auto" />
                        
                        </Grid.ColumnDefinitions>

                        <Button Content="Browse..." x:Name="BrowseButton" Click="BrowseButton_Click"
            Style="{DynamicResource RoundedButtonStyle}" Width="80" Height="24"
            HorizontalAlignment="Left" Grid.Column="0" Margin="0,0,8,0"/>

                        <Button Content="Remove" x:Name="RemoveButton" Click="RemoveButton_Click"
            Style="{DynamicResource DangerButtonStyle}" Width="80" Height="24"
            HorizontalAlignment="Right" Grid.Column="1"/>
                    </Grid>

                    <Button Content="Scan for Duplicates" x:Name="ScanButton" Click="ScanButton_Click"
        Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Cancel" Click="CancelButton_Click" x:Name="CancelButton"
        Style="{StaticResource CancelButtonStyle}"
        IsEnabled="False" />

                    <Separator Margin="0,20,0,10" Background="{DynamicResource SeparatorBrush}"/>

                    <ProgressBar x:Name="ScanProgressBar" Height="20" Margin="0,0,0,10"
                                 Foreground="{DynamicResource AccentColor}" Visibility="Collapsed"/>

                    <TextBlock x:Name="StatusText" Text="Idle" FontStyle="Italic" Foreground="{DynamicResource Text}"/>
                </StackPanel>
            </Border>


            <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Grid.Column="1" Margin="0,23,0,-13">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="257*"/>
                        <ColumnDefinition Width="19*"/>
                        <ColumnDefinition Width="304*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" Grid.ColumnSpan="3">
                        <TextBlock Text="Duplicate Files" FontSize="16" FontWeight="Bold" 
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Content="Clear List" Click="ClearListButton_Click"
                               Style="{DynamicResource DangerButtonStyle}"
                                Width="100" Height="30" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <DataGrid x:Name="DuplicatesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource DataGridBackground}"
                              Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              RowBackground="{DynamicResource DataGridRowBackground}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackground}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              MinColumnWidth="100"
                              RowHeight="32"
                              ColumnHeaderHeight="34"
                              Grid.Row="1"
                              IsReadOnly="True"
                              ItemsSource="{Binding GroupedDuplicateFiles}" Grid.ColumnSpan="3">

                        <DataGrid.Resources>

                            <Style TargetType="GroupItem">
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>



                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EEE"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#222"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3399FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        </DataGrid.Resources>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete" Click="DeleteSelected_Click"/>
                                <MenuItem Header="Open File Location" Click="OpenFolder_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="White" 
                                                BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                                                CornerRadius="6" Padding="10" Margin="0,10,0,5">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="Bold" 
                                                           FontSize="14" 
                                                           Foreground="{DynamicResource AccentColor}" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat='Files: {0}'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryText}" 
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*" />
                            <DataGridTextColumn Header="Size (KB)" Binding="{Binding FileSize}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
