<Window x:Class="MultronWinCleaner.MemCleaner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Cleaner" Height="520" Width="513"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
     
        Background="{DynamicResource WindowBackground}">

    <Border Background="{DynamicResource PanelBackground}" CornerRadius="18" Padding="0" Margin="12" Effect="{StaticResource DropShadowEffect}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

         
            <Border Background="{DynamicResource WindowBackground}" Grid.Row="0" CornerRadius="18,18,0,0" Padding="12,0" MouseDown="WindowDragMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Multron Memory Cleaner" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1" >
                        <ToggleButton x:Name="BtnSettings" Content="≡"
                                      Style="{DynamicResource ModernToggleButtonStyle}"
                                      ToolTip="Show/Hide Settings"
                                      Checked="BtnSettings_Checked"
                                      Unchecked="BtnSettings_Unchecked" />
                        <Button Width="36" Height="32" Content="─" FontSize="18" FontWeight="Bold"
                                Style="{DynamicResource ModernButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize" />
                        <Button Width="36" Height="32" Content="✕" FontSize="16" FontWeight="Bold"
                                Style="{DynamicResource DangerButtonStyle}" Click="CloseButton_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>
 
            <Grid Grid.Row="1" Margin="24,24,24,-179">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
 
                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
                    <Grid Width="210" Height="210">
                      
                        <Ellipse Width="210" Height="210"
                 Stroke="{DynamicResource TextSecondary}"
                 StrokeThickness="16" />

                        <Path x:Name="ArcPath"
      Width="210"
      Height="210"
      Stroke="{DynamicResource ProgressBarForeground}"
      StrokeThickness="16"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Stretch="None"
      RenderTransformOrigin="0.5,0.5" />


                        <TextBlock x:Name="RamUsagePercentText"
                   Text="0%" FontSize="44" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <TextBlock Text="Current RAM Usage"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,230,0,23" Grid.RowSpan="2" />
 
                <Button Name="CleanButton" Content="Clean Memory Now" Height="50"
                        Style="{StaticResource ModernButtonStyle}" FontSize="18" FontWeight="SemiBold" Grid.Row="2"
                        HorizontalAlignment="Center"
                        Width="320"
                        Click="CleanMemoryButton_Click" Margin="0,4,0,4" />

                <TextBlock x:Name="CleanedMemoryLabel" Text="" FontSize="15" Foreground="Green" 
                           HorizontalAlignment="Center" Grid.Row="3" Margin="0,44,0,0" />
 
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Width="420" Margin="0,10,0,94" Grid.RowSpan="2">

                    <Border Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="20" Visibility="Collapsed" x:Name="SettingsPanel" Margin="0,12,0,0" Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <CheckBox x:Name="chkEnableAutoClean" Content="Enable Automatic Cleaning" FontSize="16" Foreground="{DynamicResource TextPrimary}" Checked="chkEnableAutoClean_Checked" Unchecked="chkEnableAutoClean_UnChecked" Margin="0,0,0,12" />

                            <Grid VerticalAlignment="Center" Width="320" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Clean every" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="16" Grid.Column="0" Margin="0,0,12,0" />
                                <ComboBox x:Name="cbCleanInterval" Height="32" SelectedIndex="0" Grid.Column="1" FontSize="16" SelectionChanged="cbCleanInterval_SelectionChanged">
                             
                                    <ComboBoxItem Content="1 minutes"/>
                                    <ComboBoxItem Content="5 minutes" />
                                    <ComboBoxItem Content="10 minutes" />
                                    <ComboBoxItem Content="15 minutes" />
                                    <ComboBoxItem Content="30 minutes" />
                                    <ComboBoxItem Content="1 hour" />
                                    <ComboBoxItem Content="2 hour" />
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="chkSkipOnLowBattery" Content="Skip cleaning if battery lower than %30" FontSize="16" Foreground="{DynamicResource TextPrimary}" Checked="chkSkipOnLowBattery_Checked" Unchecked="chkSkipOnLowBattery_UnChecked" Margin="0,0,0,12" />

                            <CheckBox x:Name="chkShowNotification" Content="Show notification after cleaning" FontSize="16" Foreground="{DynamicResource TextPrimary}" Checked="chkShowNotification_Checked" Unchecked="chkShowNotification_UnChecked" Margin="0,0,0,12" />

                            <CheckBox x:Name="chkTopMostMonitor" Content="Keep Memory Monitor Always Top" FontSize="16" Foreground="{DynamicResource TextPrimary}" Checked="chkTopMostMonitor_Checked" Unchecked="chkTopMostMonitor_Unchecked" Margin="0,0,0,12" />

                            <CheckBox x:Name="chkSmartRAM" Content="Enable Memory Monitor Panel" FontSize="16" Foreground="{DynamicResource TextPrimary}" Checked="chkSmartRAM_Checked" Unchecked="chkSmartRAM_Unchecked" />
                            <TextBlock x:Name="Status"  Text="Auto Clean Not Working"  Foreground="{DynamicResource TextPrimary}"  FontSize="16"  FontWeight="Medium" TextAlignment="Center"  TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
