<Window x:Class="MultronWinCleaner.StartupManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup Manager" Height="624" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI"
        AllowsTransparency="True"
        Loaded="MainWindow_Loaded"
    
        WindowStyle="None" ResizeMode="CanResizeWithGrip">



    <Grid Background="{DynamicResource WindowBackground}">

        <DockPanel Background="{DynamicResource PanelBackground}" Height="55" VerticalAlignment="Top" LastChildFill="False" MouseDown="TopBar_MouseDown">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="Multron Startup Manager" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />

            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">

                <Button Content="─" Style="{DynamicResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MinimizeButton_Click" ToolTip="Minimize" Margin="0,0,6,0"/>
                <Button x:Name="buttonMaximize" Content="⤢" Style="{DynamicResource ModernButtonStyle}" Width="30" Height="30" FontSize="14" Click="MaximizeButton_Click" ToolTip="Maximize/Restore" Margin="0,0,6,0"/>
                <Button Content="✕" Style="{DynamicResource DangerButtonStyle}" Width="30" Height="30" FontSize="14" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,40,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="0.15*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" Padding="10" Margin="0,24,0,0"
                        CornerRadius="10" Grid.ColumnSpan="3" >
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <Button Content="Add" Width="80" Height="30" Style="{DynamicResource RoundedButtonStyle}" Cursor="Hand" Margin="0,0,8,0" Click="AddButton_Click"/>
                            <Button Content="Remove" Width="80" Height="30" Style="{DynamicResource RoundedButtonStyle}" Cursor="Hand" IsEnabled="False" Margin="0,0,8,0" x:Name="btnRemove" Click="RemoveButton_Click"/>
                            <Button Content="Refresh" Width="80" Height="30" Style="{DynamicResource RoundedButtonStyle}" Cursor="Hand" Click="RefreshButton_Click"/>
                            <Button Content="Apply" Width="80" Height="30" Style="{DynamicResource RoundedButtonStyle}" Name="btnApply" Cursor="Hand" Margin="10,0,0,0" Click="ApplyButton_Click" />
                            <Button Content="Add Operation" Width="113" Height="30"   Cursor="Hand" Style="{DynamicResource RoundedButtonStyle}" Margin="10,0,0,0" Click="AddOperationButton_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="StartupAppsDataGrid"
          AutoGenerateColumns="False"
          AlternationCount="2"
          SelectionMode="Single"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          Foreground="{DynamicResource TextPrimary}"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="Transparent"
          FontSize="14"
          IsReadOnly="False"
          SelectionUnit="FullRow"
          SelectionChanged="StartupAppsDataGrid_SelectionChanged">


                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource RowBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Style.Triggers>


                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="{DynamicResource AlternateRowBackground}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SelectedRowBackground}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Enabled" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding PendingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   IsEnabled="{Binding IsCheckboxEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Icon" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="24" Height="24" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                <DataGridTextColumn Header="Startup Type" Binding="{Binding StartupType}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </DockPanel>
                </Border>
                <Grid x:Name="LoadingOverlay" Background="{DynamicResource WindowBackground}" Panel.ZIndex="9999" Visibility="Visible" Margin="10,102,10,0" Grid.ColumnSpan="3">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" 
               Width="64" Height="64" Margin="0,0,0,30">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3" Color="Gray"/>
                            </Image.Effect>
                        </Image>

                        <Grid Width="48" Height="48" HorizontalAlignment="Center">

                            <Ellipse Stroke="{DynamicResource PanelBackground}" 
                     StrokeThickness="5" 
                     Opacity="0.4"/>

                            <Path Data="M 24,2 A 22,22 0 1 1 2,24" 
                  StrokeThickness="5" 
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  RenderTransformOrigin="0.5,0.5">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource ToggleOffBackgroundColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource TextColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" 
                                            Duration="0:0:0.8" 
                                            RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>

                        <TextBlock Text="Loading startup apps &amp; scheduled operations..." 
                   Foreground="{DynamicResource TextSecondary}" 
                   FontSize="13" 
                   Margin="0,20,0,0" 
                   HorizontalAlignment="Center"
                   FontWeight="Medium"
                   Opacity="0.8"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" Padding="15" Margin="10,15,10,10" CornerRadius="10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0">
                        <ToggleButton x:Name="tglShowNotifications" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="tglShowNotifications_Checked" Unchecked="tglShowNotifications_Unchecked"/>
                        <TextBlock Text="Show notification when a startup app is added in background" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
