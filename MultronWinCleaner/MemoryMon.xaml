<Window x:Class="MultronWinCleaner.MemoryMon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Monitor"
        Height="Auto" Width="235"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        MouseDown="Window_DragMove"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
  
        <Style x:Key="WidgetButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
 
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="3" 
                                ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" 
                                        Background="{TemplateBinding Foreground}" 
                                        CornerRadius="2" 
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" 
            Padding="10,8,10,10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
              
                <RowDefinition Height="Auto"/>
                
                <RowDefinition Height="Auto"/>
               
                <RowDefinition Height="Auto"/>
                
                <RowDefinition Height="Auto"/>
           
            </Grid.RowDefinitions>
 
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="PERFORMANCE" FontSize="8" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimary}" Opacity="0.5" 
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Content="✕" 
                        Width="18" Height="18"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        FontSize="10"
                        Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                        BorderThickness="0" Cursor="Hand" 
                        Click="CloseButton_Click" ToolTip="Close"/>
            </Grid>

  
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
 
                <Border Grid.Column="0" Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="RAM" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="RamPercentText" Text="0%" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="RamBar" Height="5" Maximum="100"
                                     Style="{StaticResource ModernProgressBar}"
                                     Background="{DynamicResource ProgressBarBackground}"
                                     BorderBrush="{DynamicResource ProgressBarBorder}"
                                     Foreground="#FF0078D4"/>
                    </StackPanel>
                </Border>
 
                <Border Grid.Column="2" Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="CPU" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="CpuBar" Height="5" Maximum="100"
                                     Style="{StaticResource ModernProgressBar}"
                                     Background="{DynamicResource ProgressBarBackground}"
                                     BorderBrush="{DynamicResource ProgressBarBorder}"
                                     Foreground="#FF28A745"/>
                    </StackPanel>
                </Border>
            </Grid>
 
            <UniformGrid Grid.Row="2" Columns="2" Rows="1">
                <Button Content="Clean RAM" Margin="0,0,3,0" 
                        Style="{StaticResource WidgetButtonStyle}"
                        Click="CleanMemory_Click"
                        Background="#FF0078D4" Foreground="White"/>

                <Button Content="Usage" Margin="3,0,0,0"
                        Style="{StaticResource WidgetButtonStyle}"
                        Click="SlowProcesses_Click"
                        Background="{DynamicResource AccentColorHover}" Foreground="{DynamicResource Text}"/>
            </UniformGrid>
 
            <TextBlock x:Name="FreedLabel" Grid.Row="3"
                       Text="" FontSize="10" 
                       MinHeight="14"
                       Foreground="{DynamicResource NotifyCleanedAmountForeground}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
 
            <Grid Grid.Row="4" Margin="0,6,0,0">
 
                <ListView x:Name="ProcessesListView"
                          Visibility="Collapsed"
                          Height="140"
                          Background="{DynamicResource ListBoxBackground}"
                          Foreground="{DynamicResource ListBoxForeground}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.Template>
                        <ControlTemplate TargetType="ListView">
                            <Border CornerRadius="5" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" 
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
 
                                    <Grid Grid.Row="0" Margin="4,5,18,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                           
                                            <ColumnDefinition Width="85"/>
                                           
                                            <ColumnDefinition Width="35"/>
                                           
                                            <ColumnDefinition Width="45"/>
                                          
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="APP" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Opacity="0.5" Margin="2,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="CPU" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Opacity="0.5" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="RAM" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Opacity="0.5" TextAlignment="Right"/>
                                    </Grid>

                                    <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Opacity="0.5" Margin="4,0"/>
 
                                    <ScrollViewer Grid.Row="1" Padding="0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ListView.Template>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                  
                                    <ColumnDefinition Width="85"/>
                                   
                                    <ColumnDefinition Width="35"/>
                                   
                                    <ColumnDefinition Width="45"/>
                                    
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding Icon}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="9" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="2,0,2,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontSize="9" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Ram}" FontSize="9" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
 
                <Border x:Name="LoadingBorder"
                        Height="140"
                        Background="{DynamicResource ListBoxBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  
                        <Grid Width="22" Height="22" Margin="0,0,0,6">
                            <Ellipse Stroke="{DynamicResource TextPrimary}" StrokeThickness="2" Opacity="0.2"/>
                            <Path Data="M 11,2 A 9,9 0 0 1 20,11" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF0078D4" Offset="0"/>
                                        <GradientStop Color="#000078D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.7" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock Text="Loading..." FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Opacity="0.6" HorizontalAlignment="Center">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>