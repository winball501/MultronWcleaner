<Window x:Class="MultronWinCleaner.MemoryMon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Monitor"
        Height="120" Width="280"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        MouseDown="Window_DragMove"
        AllowsTransparency="True">

    <Border CornerRadius="12"
        Background="{DynamicResource PanelBackground}"
        Padding="6"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1" Margin="0,0,0,39">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="99*"/>
                <ColumnDefinition Width="34*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Margin="13,0,0,0" Grid.ColumnSpan="2">
                <StackPanel Width="100" Margin="0,0,8,0" Height="26">
                    <TextBlock Text="RAM"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ProgressBar x:Name="RamBar"
                                     Height="5" Width="70" Maximum="100"
                                     Background="{DynamicResource ProgressBarBackground}"
                                     BorderBrush="{DynamicResource ProgressBarBorder}"/>
                        <TextBlock x:Name="RamPercentText"
                                   Text="0%"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Width="100" Margin="0,0,8,0" Height="25">
                    <TextBlock Text="CPU"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="10" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ProgressBar x:Name="CpuBar"
                                     Height="5" Width="70" Maximum="100"
                                     Background="{DynamicResource ProgressBarBackground}"
                                     BorderBrush="{DynamicResource ProgressBarBorder}"/>
                        <TextBlock x:Name="CpuPercentText"
                                   Text="0%"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Content="🧼"
                            Width="20" Height="18" ToolTip="Clean RAM"
                            FontSize="9" Click="CleanMemory_Click"
                            Background="{DynamicResource AccentColor}"
                            Foreground="{DynamicResource Text}"
                            BorderThickness="0"
                            Margin="0,0,0,2" Cursor="Hand"/>
                    <Button Content="🐢"
                            Width="20" Height="18" ToolTip="Slow CPU"
                            FontSize="9" Click="SlowProcesses_Click"
                            Background="{DynamicResource AccentColorHover}"
                            Foreground="{DynamicResource Text}"
                            BorderThickness="0"
                            Margin="0,0,0,2" Cursor="Hand"/>
                    <Button Content="✖"
                            Width="20" Height="18" ToolTip="Close"
                            FontSize="9" Click="CloseButton_Click"
                            Background="{DynamicResource DangerButtonBackground}"
                            Foreground="{DynamicResource Text}"
                            BorderThickness="0"
                            Margin="0,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="FreedLabel"
                       Text=""
                       FontSize="9" Foreground="{DynamicResource NotifyCleanedAmountForeground}"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="13,0,0,43"/>
            <ListView x:Name="ProcessesListView"
   Grid.Row="2"
   Visibility="Collapsed"
   Margin="0,4,0,0"
   Background="{DynamicResource ListBoxBackground}"
   Foreground="{DynamicResource ListBoxForeground}"
   BorderBrush="{DynamicResource BorderBrush}"
   BorderThickness="1" Grid.ColumnSpan="2">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="9" Width="120"
                    Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Cpu}" FontSize="9" Width="40"
                    Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Ram}" FontSize="9"
                    Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</Window>