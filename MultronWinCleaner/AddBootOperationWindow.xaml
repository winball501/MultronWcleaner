<Window x:Class="MultronWinCleaner.AddBootOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Boot Operation"
        Height="270" Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        AllowsTransparency="True"
        >

    <Border CornerRadius="12" 
            Background="{DynamicResource WindowBackground}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            Padding="10"
            SnapsToDevicePixels="True"
            >

        <DockPanel>

            <!-- Title Bar -->
            <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource AccentColorBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Add Boot Operation" 
                           VerticalAlignment="Center" 
                           Margin="12,0,0,0" 
                           Foreground="{DynamicResource AccentTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           />

                <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource AccentTextBrush}" 
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Close">
                    ×
                </Button>
            </Grid>

            <!-- Content -->
            <StackPanel Margin="0,15,0,0" VerticalAlignment="Top">
                <ComboBox x:Name="cmbOperationType" Margin="0,0,0,10" >
                    <ComboBoxItem Content="Delete" />
                    <ComboBoxItem Content="Move" />
                    <ComboBoxItem Content="Rename" />
                </ComboBox>

                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtSourcePath" Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource TextBoxForeground}" />
                    <TextBlock Text="Source file/folder path"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource WatermarkBrush}"
                               Margin="5,2,0,0"
                               VerticalAlignment="Center"
                               Padding="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSourcePath}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSourcePath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSourcePath}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtDestPath" IsEnabled="False"
                             Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource TextBoxForeground}" />
                    <TextBlock Text="Destination path (for Move/Rename)"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource WatermarkBrush}"
                               Margin="5,2,0,0"
                               VerticalAlignment="Center"
                               Padding="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtDestPath}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtDestPath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtDestPath}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Content="Add" Click="Add_Click" HorizontalAlignment="Right" Width="80"
                        Background="{DynamicResource AccentColorBrush}" 
                        Foreground="{DynamicResource AccentTextBrush}"
                        Padding="6,2"
                        FontWeight="SemiBold"
                        />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
