<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#f0f0f0</Color>
    <Color x:Key="DangerColor">#e74c3c</Color>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEE"/>
     
        <Setter Property="Foreground" Value="#222"/>
    
        <Setter Property="BorderBrush" Value="#CCC"/>
         
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#222222"/>
      
        <Setter Property="Background" Value="White"/>
      
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
    </Style>
    
    <SolidColorBrush x:Key="GroupHeaderBackground" Color="#0078d7"/>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />

    <Color x:Key="PanelBackgroundColor">#ffffff</Color>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}" />

    <Color x:Key="DataGridBackgroundColor">#ffffff</Color>
    <SolidColorBrush x:Key="DataGridBackground" Color="{StaticResource DataGridBackgroundColor}" />

    <Color x:Key="DataGridHeaderBackgroundColor">#e1e1e1</Color>
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="{StaticResource DataGridHeaderBackgroundColor}" />

    <Color x:Key="DataGridGridLinesColor">#cccccc</Color>
    <SolidColorBrush x:Key="DataGridGridLines" Color="{StaticResource DataGridGridLinesColor}" />

    <Color x:Key="DataGridCellBackgroundColor">#ffffff</Color>
    <SolidColorBrush x:Key="DataGridCellBackground" Color="{StaticResource DataGridCellBackgroundColor}" />

    <Color x:Key="AccentColorColor">#0078d7</Color>
    <SolidColorBrush x:Key="AccentColor" Color="{StaticResource AccentColorColor}" />

    <SolidColorBrush x:Key="DataGridRowBackground" Color="#f9f9f9"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackground" Color="#eeeeee"/>


    <SolidColorBrush x:Key="SecondaryText" Color="White" />

    <SolidColorBrush x:Key="TextBoxBackground" Color="White" />
   

    <SolidColorBrush x:Key="SeparatorBrush" Color="#ccc" />
 
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
    
    <SolidColorBrush x:Key="ButtonSuccessBackground" Color="#4CAF50"/>

    <SolidColorBrush x:Key="ButtonDangerBackground" Color="#e74c3c"/>
 
    <SolidColorBrush x:Key="ListBoxBackground" Color="White"/>
     
    <SolidColorBrush x:Key="ControlBackground" Color="#F3F3F3"/>
   
    <SolidColorBrush x:Key="ProgressBarBackground" Color="#D6D6D6"/>
   
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#4CAF50"/>
     


    <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F9F9F9" Offset="0.0"/>
        <GradientStop Color="#E1E1E1" Offset="1.0"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0078D4" Offset="0.0"/>
        <GradientStop Color="#0061A8" Offset="1.0"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="ButtonHoverBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3399FF" Offset="0.0"/>
        <GradientStop Color="#005B96" Offset="1.0"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="ButtonDisabledBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BFBFBF" Offset="0.0"/>
        <GradientStop Color="#BFBFBF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Text" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="Black" Offset="0.0"/>

        <GradientStop Color="Black" Offset="1.0"/>

    </LinearGradientBrush>
    
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border.CornerRadius>
                            <CornerRadius TopLeft="20" TopRight="20" BottomLeft="20" BottomRight="20"/>
                        </Border.CornerRadius>

                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.3" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Background" Value="{StaticResource ButtonDisabledBackground}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Foreground" Value="Gray"/>
            </DataTrigger>
            
        </Style.Triggers>
        
    </Style>
    
</ResourceDictionary>