<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#444"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="#555"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

   
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#555"/>
    </Style>
    <SolidColorBrush x:Key="GroupHeaderBackground" Color="#FF2D2D30"/>
  
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A96DD"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#3A96DD"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
    <Color x:Key="WindowBackgroundColor">#1e1e1e</Color>
    <Color x:Key="DangerColor">#B61423</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />

    <SolidColorBrush x:Key="DataGridRowBackground" Color="#2c2c2c"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackground" Color="#262626"/>
    <Color x:Key="PanelBackgroundColor">#2d2d30</Color>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}" />

   
    <Color x:Key="DataGridBackgroundColor">#252526</Color>
    <SolidColorBrush x:Key="DataGridBackground" Color="{StaticResource DataGridBackgroundColor}" />

    <Color x:Key="DataGridHeaderBackgroundColor">#3c3c3c</Color>
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="{StaticResource DataGridHeaderBackgroundColor}" />

    <Color x:Key="DataGridGridLinesColor">#444444</Color>
    <SolidColorBrush x:Key="DataGridGridLines" Color="{StaticResource DataGridGridLinesColor}" />

    <Color x:Key="DataGridCellBackgroundColor">#2d2d30</Color>
    <SolidColorBrush x:Key="DataGridCellBackground" Color="{StaticResource DataGridCellBackgroundColor}" />

 
    <Color x:Key="AccentColorColor">#0a84ff</Color>
    <SolidColorBrush x:Key="AccentColor" Color="{StaticResource AccentColorColor}" />

   
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#333" />

  
    <SolidColorBrush x:Key="Text" Color="White" />
    <SolidColorBrush x:Key="SecondaryText" Color="#a0a0a0" />

 
    <SolidColorBrush x:Key="TextBoxBackground" Color="#3c3c3c" />
    <SolidColorBrush x:Key="BorderBrush" Color="#555" />

  
    <SolidColorBrush x:Key="SeparatorBrush" Color="#555" />
     

    <SolidColorBrush x:Key="ControlBackground" Color="#2A2A2A"/>

    <SolidColorBrush x:Key="ListBoxBackground" Color="#252525"/>


    <SolidColorBrush x:Key="ButtonSuccessBackground" Color="#2E7D32"/>

    <SolidColorBrush x:Key="ButtonDangerBackground" Color="#B61423"/>


    <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C2C2C" Offset="0.0"/>
        <GradientStop Color="#444444" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E1E1E" Offset="0.0"/>
        <GradientStop Color="#333333" Offset="1.0"/>
    </LinearGradientBrush>

    

    <LinearGradientBrush x:Key="ButtonDisabledBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#555555" Offset="0.0"/>
        <GradientStop Color="#555555" Offset="1.0"/>
    </LinearGradientBrush>

  
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border.CornerRadius>
                            <CornerRadius TopLeft="20" TopRight="20" BottomLeft="20" BottomRight="20"/>
                        </Border.CornerRadius>

                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.3"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackground}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Foreground" Value="Gray"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>