<Window x:Class="MultronWinCleaner.Utilities"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utilities" Height="781" Width="800"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid>

        <!-- ÜST SABİT PANEL -->
        <Border Background="{DynamicResource PanelBackground}" Height="56" VerticalAlignment="Top" CornerRadius="10"
                Margin="10,10,10,0"
                MouseDown="TopPanel_MouseLeftButtonDown"
                Effect="{StaticResource DropShadowEffect}">
            <DockPanel LastChildFill="False" Margin="16,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🧼 Multron Win Cleaner Utilities"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- SABİT X BUTONU -->
        <Button Content="✖"
                FontSize="12" FontWeight="Bold"
                Foreground="White"
                Background="{DynamicResource DangerButtonBackground}"
                BorderBrush="Transparent"
                Width="30" Height="28"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Margin="0,18,20,0"
                Cursor="Hand"
                Style="{StaticResource RoundedButtonStyle}" />

        <!-- SCROLL EDİLEBİLİR ALT KISIM -->
        <ScrollViewer Margin="0,76,0,0"
              VerticalScrollBarVisibility="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              
              Padding="10,0,10,10">
            <Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kart 1: Firewall Cleaner -->
                    <Border Grid.Row="0" Grid.Column="0" Margin="10" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Firewall Rule Cleaner"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock Text="Removes broken or orphaned rules from Windows Firewall."
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="FirewallProgress" Height="18" Minimum="0" Maximum="100" Value="0"
                                         Margin="0,0,0,5" Foreground="{DynamicResource ButtonNormalBackground}"
                                         Background="#DDD" Visibility="Collapsed"/>
                            <ListBox x:Name="FirewallInvalidRulesList" Height="120"
                                     Background="{DynamicResource PanelBackground}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="Transparent" Margin="0,0,0,5" Visibility="Collapsed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Label x:Name="FirewallScanResultLabel" FontWeight="Bold" FontSize="13"
                                   Margin="0,5,0,0" Visibility="Collapsed"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextPrimary}"/>
                            <Button x:Name="FirewallScan" Content="Start Scan" Margin="0,10,0,0"
                                    Width="140" Height="36" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="FirewallClean_Click"
                                    Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Kart 2: Large File Finder -->
                    <Border Grid.Row="0" Grid.Column="1" Margin="10" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Large File Finder" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock Text="Scans a selected folder for the largest files consuming disk space."
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Launch" Margin="0,15,0,0" Width="140" Height="36" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="LargeFilesScan_Click"
                                    Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Kart 3: Duplicate File Finder -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="10" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Duplicate File Finder" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock Text="Scans a selected folder to find duplicate files and helps you clean up disk space."
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Launch" Width="140" Height="36" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="DuplicateFilesScan_Click"
                                    Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Kart 4: Turbo Boost -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="10" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Turbo Boost (Game Mode)" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock Text="Temporarily stops unnecessary Windows services to free up system resources for gaming or heavy tasks."
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock FontSize="13" Foreground="DodgerBlue" Margin="0,0,0,10" Cursor="Hand">
                                <Hyperlink Click="ConfigureTurboBoost_Click">Configure</Hyperlink>
                            </TextBlock>
                            <Button x:Name="Turbo" Content="Activate Turbo Boost" Width="180" Height="36"
                                    HorizontalAlignment="Left" Cursor="Hand"
                                    Click="ActivateTurboBoost_Click"
                                    Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Kart 5: Memory Cleaner -->
                    <Border Grid.Row="2" Grid.Column="0" Margin="10" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Memory Cleaner" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock Text="Launch the Memory Cleaner utility." FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Launch" Width="140" Height="36" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="OpenMemoryCleaner_Click"
                                    Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Kart 6: Registry Cleaner -->
                    <Border Grid.Row="2" Grid.Column="1" Margin="10" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Registry Cleaner" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock Text="Scan and clean invalid or obsolete registry entries to improve system performance."
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Launch" Width="140" Height="36" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="OpenRegistryCleaner_Click"
                                    Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Alt Tanıtım Paneli -->
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="10,10,10,0" Padding="15"
                            Background="{DynamicResource PanelBackground}" CornerRadius="12"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Width="180" Margin="0,0,40,0">
                                <TextBlock Text="Hydra Dragon Antivirus" FontSize="16" FontWeight="Bold" Foreground="#1EA7FF" TextAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Open Source Powerful antivirus Software" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Download" Width="140" Height="32" Cursor="Hand" Click="HydraDownloadButton_Click"
                                        Style="{StaticResource RoundedButtonStyle}"/>
                            </StackPanel>
                            <StackPanel Width="180">
                                <TextBlock Text="Multron File Guardian" FontSize="16" FontWeight="Bold" Foreground="#1EA7FF" TextAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Advanced file encryption and protection software." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Download" Width="140" Height="32" Cursor="Hand" Click="FileGuardianDownloadButton_Click"
                                        Style="{StaticResource RoundedButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
