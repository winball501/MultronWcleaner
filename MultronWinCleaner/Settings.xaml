<Window x:Class="MultronWinCleaner.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="780" Width="880"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI Variable">

    <Window.Resources>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <DropShadowEffect x:Key="DropShadowSoft" Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
    </Window.Resources>

    <Grid>
        
        <Button Content="✖" FontSize="12" FontWeight="Bold"
                Foreground="{DynamicResource DangerButtonForeground}"
                Background="{DynamicResource ButtonDangerBackground}" BorderBrush="Transparent"
                Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="12" Click="CloseButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="22" Padding="28"
                Margin="28,56,28,52" Effect="{StaticResource DropShadowSoft}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" Margin="0,0,0,4">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,18" />

                    <Button Content="Save Settings" Background="{DynamicResource ButtonHoverBackground}" 
                            Foreground="{DynamicResource ButtonForeground}"
                            HorizontalAlignment="Left" Width="180" Height="39" 
                            Click="SaveSettings_Click" Margin="0,0,0,18" />
 
                    <GroupBox Header="User Profile Selection" Margin="0,0,0,18" Padding="12"
                              Foreground="{DynamicResource TextPrimary}">
                        <StackPanel>
                            <TextBlock Text="Select user profile to clean:" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="comboBoxUserSelection" Width="697" Height="32"
                                      Background="{DynamicResource TextBoxBackground}"
                                      Foreground="{DynamicResource TextBoxForeground}"
                                      BorderBrush="{DynamicResource BorderBrush}" Padding="6"
                                      FontSize="14" FontWeight="SemiBold"
                                      SelectionChanged="comboBoxUserSelection_SelectionChanged"/>
                            <Button Name="ApplyButton" Content="Apply Selection" Width="119" Height="32" Margin="0,8,0,0"
                                    Background="{DynamicResource ButtonHoverBackground}" 
                                    Foreground="{DynamicResource ButtonForeground}" HorizontalAlignment="Left"
                                    Click="ApplyUserSelection_Click"/>
                        </StackPanel>
                    </GroupBox>
 
                    <GroupBox Header="Automatic Cleaning" Margin="0,0,0,18" Padding="12"
                              Foreground="{DynamicResource TextPrimary}">
                        <StackPanel>
                            <CheckBox Content="Enable Automatic Cleaning" x:Name="chkAutoClean"
                                      Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,0,12"
                                      Checked="chkAutoClean_Checked"/>
                            <ComboBox x:Name="cmbScheduleType" Width="200" Margin="0,0,0,12" FontSize="14"
                                      Background="{DynamicResource TextBoxBackground}" 
                                      Foreground="{DynamicResource TextBoxForeground}">
                                <ComboBoxItem Content="Instant"/>
                                <ComboBoxItem Content="Daily"/>
                                <ComboBoxItem Content="Weekly"/>
                                <ComboBoxItem Content="Custom Days"/>
                            </ComboBox>
                            <WrapPanel Margin="0,0,0,12">
                                <CheckBox x:Name="Day7" Content="Mon" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day6" Content="Tue" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day5" Content="Wed" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day4" Content="Thu" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day3" Content="Fri" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day2" Content="Sat" Style="{StaticResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day1" Content="Sun" Style="{StaticResource CustomCheckBoxStyle}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Cleaning Interval (min):" FontSize="15" 
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBox x:Name="txtCleaningInterval" Width="100" Text="0"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         PreviewTextInput="txtCleaningInterval_PreviewTextInput" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="txtClock" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Text="Computer Time: 00:00"
                                       Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Allowed Time Range:" FontSize="15" 
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBox x:Name="txtStartTime" Width="100" Text="08:00" 
                                         Style="{StaticResource ModernTextBoxStyle}" Margin="12,0,0,0"/>
                                <TextBlock Text="-" FontSize="15" Margin="6,0" VerticalAlignment="Center" />
                                <TextBox x:Name="txtEndTime" Width="100" Text="22:00"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                  
                    <GroupBox Header="Conditions" Margin="0,0,0,18" Padding="12"
                              Foreground="{DynamicResource TextPrimary}">
                        <StackPanel>
                            <CheckBox x:Name="SkipBatterry" Content="Skip if battery is below 30%"
                                      Style="{StaticResource CustomCheckBoxStyle}"/>
                            <CheckBox x:Name="RunIfInactive" Content="Run only if user is inactive for 15 min"
                                      Style="{StaticResource CustomCheckBoxStyle}"/>
                            <CheckBox x:Name="OnlyLowCPU" Content="Run only if CPU usage is below 20%"
                                      Style="{StaticResource CustomCheckBoxStyle}"/>

                           
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"/>
                        </StackPanel>
                    </GroupBox>

                      <GroupBox Header="After Cleaning" Margin="0,0,0,18" Padding="12"
                              Foreground="{DynamicResource TextPrimary}">
                        <ComboBox x:Name="cmbPostCleanupAction" Width="240" FontSize="14"
                                  Background="{DynamicResource TextBoxBackground}"
                                  Foreground="{DynamicResource TextBoxForeground}"
                                  BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="Do Nothing"/>
                            <ComboBoxItem Content="Shutdown"/>
                            <ComboBoxItem Content="Restart"/>
                            <ComboBoxItem Content="LogOff"/>
                        </ComboBox>
                    </GroupBox>

              
                    <GroupBox Header="System Tray" Margin="0,0,0,18" Padding="12"
                              Foreground="{DynamicResource TextPrimary}">
                        <CheckBox x:Name="chkTrayIcon" Content="Enable System Tray Icon"
                                  Style="{StaticResource CustomCheckBoxStyle}" Checked="chkTrayIcon_Checked"/>
                    </GroupBox>
 
                    <GroupBox Header="Exceptions" Margin="0,0,0,18" Padding="12"
                              Foreground="{DynamicResource TextPrimary}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtExceptionPath" Style="{StaticResource ModernTextBoxStyle}"
                                         Height="32" Margin="0,0,6,0" VerticalAlignment="Center" Grid.Column="0"/>
                                <Button Content="Add" Width="60" Height="32" Grid.Column="1"
                                        Background="{DynamicResource ButtonHoverBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Click="AddException_Click" Margin="0,0,6,0"/>
                                <Button Content="Remove" Width="70" Height="32" Grid.Column="2"
                                        Background="{DynamicResource ButtonHoverBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Click="RemoveException_Click" Margin="0,0,6,0"/>
                                <Button Content="Remove All" Width="85" Height="32" Grid.Column="3"
                                        Background="{DynamicResource ButtonHoverBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Click="RemoveExceptionAll_Click"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Background="{DynamicResource TextBoxBackground}" Padding="6">
                                <ListBox x:Name="lstExceptions" Height="145" FontSize="14"
                                         Background="{DynamicResource TextBoxBackground}"
                                         Foreground="{DynamicResource TextBoxForeground}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
