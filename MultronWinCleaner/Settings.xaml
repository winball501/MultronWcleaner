<Window x:Class="MultronWinCleaner.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="780" Width="880"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        AllowsTransparency="True"
        FontFamily="Inter, Segoe UI, Arial, sans-serif">
      
  

    <Grid>

        <Button Content="✕"
        Style="{StaticResource DangerButtonStyle}"
        Width="30" Height="30"
        FontSize="14"
        Click="CloseButton_Click"
        ToolTip="Close"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="12"
        Cursor="Hand"/>
        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="28"
                Margin="28,56,28,49">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" Margin="0,0,0,4">
                <StackPanel Margin="0,0,10,0">

                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"
                               FontFamily="Inter, Segoe UI, Arial, sans-serif" />

                    <Button Content="Save Settings" 
                            HorizontalAlignment="Left" Width="180" Height="42" 
                            Click="SaveSettings_Click" Margin="0,0,0,20"
                            FontFamily="Inter, Segoe UI, Arial, sans-serif"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <GroupBox Header="User Profile Selection" Style="{DynamicResource CustomGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Select user profile to clean:" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="comboBoxUserSelection" Width="697" Height="34"
                                      Background="{DynamicResource TextBoxBackground}"
                                      Foreground="{DynamicResource TextBoxForeground}"
                                      BorderBrush="{DynamicResource BorderBrush}" Padding="8"
                                      FontSize="15" FontWeight="Medium"
                                      SelectionChanged="comboBoxUserSelection_SelectionChanged"/>
                            <Button Name="ApplyButton" Content="Apply Selection" Width="120" Height="34" Margin="0,8,0,0"
                                    Click="ApplyUserSelection_Click"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Automatic Cleaning" Style="{DynamicResource CustomGroupBoxStyle}">
                        <StackPanel>
                            <CheckBox Content="Enable Automatic Cleaning" x:Name="chkAutoClean"
                                      Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,0,14"
                                      Checked="chkAutoClean_Checked"/>
                            <ComboBox x:Name="cmbScheduleType" Width="220" Margin="0,0,0,14" FontSize="15"
                                      Background="{DynamicResource TextBoxBackground}" 
                                      Foreground="{DynamicResource TextBoxForeground}"
                                      FontWeight="Medium">
                                <ComboBoxItem Content="Instant"/>
                                <ComboBoxItem Content="Daily"/>
                                <ComboBoxItem Content="Weekly"/>
                                <ComboBoxItem Content="Custom Days"/>
                            </ComboBox>
                            <WrapPanel Margin="0,0,0,14" HorizontalAlignment="Left" >
                                <CheckBox x:Name="Day7" Content="Mon" Style="{DynamicResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day6" Content="Tue" Style="{DynamicResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day5" Content="Wed" Style="{DynamicResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day4" Content="Thu" Style="{DynamicResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day3" Content="Fri" Style="{DynamicResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day2" Content="Sat" Style="{DynamicResource CustomCheckBoxStyle}" />
                                <CheckBox x:Name="Day1" Content="Sun" Style="{DynamicResource CustomCheckBoxStyle}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <TextBlock Text="Cleaning Interval (min):" FontSize="15" 
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                           FontWeight="Medium" />
                                <TextBox x:Name="txtCleaningInterval" Width="100" Text="0"
                                         Style="{DynamicResource RoundedTextBox}"
                                         PreviewTextInput="txtCleaningInterval_PreviewTextInput" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="txtClock" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Text="Computer Time: 00:00"
                                       Margin="0,0,0,14"
                                       />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <TextBlock Text="Allowed Time Range:" FontSize="15" 
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                           FontWeight="Medium" />
                                <TextBox x:Name="txtStartTime" Width="100" Text="08:00" 
                                         Style="{DynamicResource RoundedTextBox}" Margin="12,0,0,0"/>
                                <TextBlock Text="-" FontSize="15" Margin="6,0" VerticalAlignment="Center" />
                                <TextBox x:Name="txtEndTime" Width="100" Text="22:00"
                                         Style="{DynamicResource RoundedTextBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Conditions" Style="{DynamicResource CustomGroupBoxStyle}">
                        <StackPanel>
                            <CheckBox x:Name="SkipBatterry" Content="Skip if battery is below 30%" Style="{DynamicResource CustomCheckBoxStyle}" />
                            <CheckBox x:Name="RunIfInactive" Content="Run only if user is inactive for 15 min" Style="{DynamicResource CustomCheckBoxStyle}" />
                            <CheckBox x:Name="OnlyLowCPU" Content="Run only if CPU usage is below 20%" Style="{DynamicResource CustomCheckBoxStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="After Cleaning" Style="{DynamicResource CustomGroupBoxStyle}">
                        <ComboBox x:Name="cmbPostCleanupAction" Width="240" FontSize="15"
                                  Background="{DynamicResource TextBoxBackground}"
                                  Foreground="{DynamicResource TextBoxForeground}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  FontWeight="Medium">
                            <ComboBoxItem Content="Do Nothing"/>
                            <ComboBoxItem Content="Shutdown"/>
                            <ComboBoxItem Content="Restart"/>
                            <ComboBoxItem Content="LogOff"/>
                        </ComboBox>
                    </GroupBox>

                    <GroupBox Header="System Tray" Style="{DynamicResource CustomGroupBoxStyle}">
                        <CheckBox x:Name="chkTrayIcon" Content="Enable System Tray Icon"
                                  Style="{DynamicResource CustomCheckBoxStyle}" Checked="chkTrayIcon_Checked"/>
                    </GroupBox>

                    <GroupBox Header="Exceptions" Style="{DynamicResource CustomGroupBoxStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtExceptionPath" Style="{DynamicResource ModernTextBoxStyle}"
                                         Height="34" Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="0"/>
                                <Button Content="Add" Width="64" Height="34" Grid.Column="1"
                                        Background="{DynamicResource ButtonHoverBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Click="AddException_Click" Margin="0,0,8,0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"/>
                                <Button Content="Remove" Width="75" Height="34" Grid.Column="2"
                                        Background="{DynamicResource ButtonHoverBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Click="RemoveException_Click" Margin="0,0,8,0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"/>
                                <Button Content="Remove All" Width="90" Height="34" Grid.Column="3"
                                        Background="{DynamicResource ButtonHoverBackground}"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        Click="RemoveExceptionAll_Click"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Background="{DynamicResource TextBoxBackground}" Padding="8">
                                <ListBox x:Name="lstExceptions" Height="145" FontSize="15"
                                         Background="{DynamicResource TextBoxBackground}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="Inter, Segoe UI, Arial, sans-serif"/>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
