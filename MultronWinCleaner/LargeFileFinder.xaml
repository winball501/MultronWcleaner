<Window
    x:Class="MultronWinCleaner.LargeFileFinder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Large File Finder"
    Height="600" Width="900"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    AllowsTransparency="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBackground}">

    <Grid>
      
        <Border Background="{DynamicResource ButtonHoverBackground}" Padding="2" VerticalAlignment="Top" MouseLeftButtonDown="TopPanel_MouseLeftButtonDown">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0">
                    <TextBlock Text="Large File Finder" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text=" | Multron Tools" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="5,0,0,0"/>
                </StackPanel>

                <Button Content="-" Click="MinimizeButton_Click"
                        FontSize="14" FontWeight="Bold" Width="40" Height="30" Grid.Column="1"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"/>

                <Button Content="⛶" Click="MaximizeButton_Click"
                        FontSize="14" FontWeight="Bold" Width="40" Height="30" Grid.Column="2"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"/>

                <Button Content="X" Click="CloseButton_Click"
                        FontSize="14" FontWeight="Bold" Width="40" Height="30" Grid.Column="3"
                        Background="{DynamicResource ButtonDangerBackground}" Foreground="White" BorderBrush="Transparent"/>
            </Grid>
        </Border>

  
        <Grid Margin="20,50,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
 
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Grid.Column="0" Margin="0,0,15,0">
                <StackPanel Margin="15">
                    <TextBlock Text="Scan Directory:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource Text}"/>

                    <ListBox x:Name="FolderListBox" Height="100"
                             Background="{DynamicResource TextBoxBackground}"
                             Foreground="{DynamicResource Text}"
                             BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="Browse..." Click="AddFolder_Click" Width="100" Margin="0,0,5,0"
                                Background="{DynamicResource ButtonHoverBackground}" Foreground="{DynamicResource Text}" BorderBrush="Transparent"/>
                        <Button Content="Remove" Click="RemoveSelectedFolder_Click" Width="100"
                                Background="{DynamicResource ButtonDangerBackground}" Foreground="White" BorderBrush="Transparent"/>
                    </StackPanel>

                    <TextBlock Text="Min File Size:" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="{DynamicResource Text}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="SizeThresholdTextBox" Text="100" Width="100"
                                 Background="{DynamicResource TextBoxBackground}" Foreground="Black" BorderBrush="{DynamicResource BorderBrush}"/>
                        <ComboBox x:Name="SizeUnitComboBox" Width="80" Margin="10,0,0,0"
                                  Background="{DynamicResource TextBoxBackground}" Foreground="Black" BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="KB" Foreground="Black"/>
                            <ComboBoxItem Content="MB" Foreground="Black"/>
                            <ComboBoxItem Content="GB" Foreground="Black"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Name="StartScan" Content="Scan for Large Files" Click="StartScan_Click" Height="35" Margin="0,0,0,10"
                            Background="{DynamicResource AccentColor}" Foreground="Black" BorderBrush="Black"/>

                    <Button Name="CancelScan" Content="Cancel Scan" Click="CancelScan_Click" Height="35" Margin="0,0,0,10" IsEnabled="False"
                            Background="{DynamicResource ButtonDangerBackground}" Foreground="Black" BorderBrush="Black"/>

                    <Separator Margin="0,20,0,10" Background="{DynamicResource SeparatorBrush}"/>

                    <ProgressBar x:Name="ScanProgressBar" Height="20" Margin="0,0,0,10"
                                 Foreground="{DynamicResource AccentColor}" Visibility="Collapsed"/>

                    <TextBlock x:Name="ScanResultLabel" Text="Idle" FontStyle="Italic" Foreground="{DynamicResource Text}"/>
                </StackPanel>
            </Border>
 
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Grid.Column="1">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Large Files" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Content="Clear List" Click="ClearListButton_Click" Width="100" Height="30" DockPanel.Dock="Right"
                                Background="{DynamicResource ButtonDangerBackground}" Foreground="White" BorderBrush="Transparent"/>
                    </DockPanel>

                    <DataGrid x:Name="LargeFilesDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{DynamicResource DataGridBackground}" Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              RowBackground="{DynamicResource DataGridRowBackground}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackground}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              IsReadOnly="True" ItemsSource="{Binding LargeFileItems}">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open File Location" Click="OpenFileLocation_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMB}" Width="100"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
