<TreeView x:Name="DuplicatesTreeView" 
          VirtualizingStackPanel.IsVirtualizing="True" 
          VirtualizingStackPanel.VirtualizationMode="Recycling" 
          Background="Transparent" 
          BorderThickness="0" 
          Foreground="{DynamicResource TextPrimary}">

    <TreeView.Resources>

        <!-- Folder Template -->
        <HierarchicalDataTemplate DataType="{x:Type local:FolderNodeModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📁 Open Folder" Tag="{Binding FullPath}" Click="ContextMenu_OpenFolder_Click"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>

                <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentColor}" CornerRadius="10" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalDuplicateCount}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- File Template (shows which file it matches with; hash moved into ToolTip) -->
        <DataTemplate DataType="{x:Type local:FileNodeModel}">
            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📄 Open File" Tag="{Binding FilePath}" Click="ContextMenu_OpenFile_Click"/>
                        <MenuItem Header="📂 Open File Location" Tag="{Binding FilePath}" Click="ContextMenu_OpenFileLocation_Click"/>
                        <Separator/>
                        <MenuItem Header="🔍 Open Matching File Location" Tag="{Binding MatchedFilePath}" Click="ContextMenu_OpenFileLocation_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForDeletion}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="{Binding FileIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentColor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MatchedFilePath}">
                        <Run Text="↔ Matches:"/>
                        <Run Text="{Binding MatchedFileName}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center" Margin="15,0,5,0" ToolTip="{Binding Hash, StringFormat='Hash: {0}'}"/>
            </Grid>
        </DataTemplate>
    </TreeView.Resources>

    <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </TreeView.ItemContainerStyle>
</TreeView>