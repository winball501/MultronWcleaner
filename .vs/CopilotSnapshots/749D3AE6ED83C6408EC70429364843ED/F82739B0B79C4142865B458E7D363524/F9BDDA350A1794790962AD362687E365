                TotalSizeText.Visibility = Visibility.Collapsed;
                SearchCountText.Text = "";
                await RunScanAsync();
                 

                if (allDuplicates.Count > 0)
                {
                    _isScanned = true;
                    MainActionButton.Content = "CLEAN";
                    MainActionButton.Background = new SolidColorBrush(Colors.Crimson);
                }
                else
                {
                    ResetToScanState();
                }

                MainActionButton.IsEnabled = true;
            }
            else if(MainActionButton.Content == "Cancel")
            {
                _cts?.Cancel();
                MainActionButton.IsEnabled = false;
            } else
            {

                CleanDuplicates();
            }
        }

       

        private void CleanDuplicates()
        {
            MessageBoxResult result = MessageBox.Show(
                "This will keep ONE original file from each duplicate group and permanently delete the rest. Are you sure?",
                "Confirm Cleanup",
                MessageBoxButton.YesNo,
                MessageBoxImage.Warning);

            if (result == MessageBoxResult.Yes)
            {
                int deletedCount = 0;
                var groups = allDuplicates.GroupBy(d => d.Hash);

                foreach (var group in groups)
                {
                    if (group.Count() > 1)
                    {
                        var filesToDelete = group.Skip(1).ToList();
                        foreach (var file in filesToDelete)
                        {
                            try
                            {
                                if (File.Exists(file.FilePath))
                                {
                                    File.Delete(file.FilePath);
                                    deletedCount++;
                                }
                            }
                            catch
                            {

                            }
                        }
                    }
                }

                MessageBox.Show($"Cleanup Complete!\n\nSuccessfully deleted {deletedCount} duplicate files.", "Success", MessageBoxButton.OK, MessageBoxImage.Information);
                 
                ClearListButton_Click(null, null);
                ResetToScanState();
            }
        }

        private void ResetToScanState()
        {
            _isScanned = false;
            MainActionButton.Content = "SCAN";
