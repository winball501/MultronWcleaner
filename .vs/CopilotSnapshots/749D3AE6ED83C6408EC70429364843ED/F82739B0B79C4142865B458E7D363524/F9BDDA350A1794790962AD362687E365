        private void SearchBox_TextChanged(object sender, TextChangedEventArgs e)
        {
            string query = SearchBox.Text.ToLower().Trim();

            if (string.IsNullOrEmpty(query))
            {
                DuplicatesTreeView.ItemsSource = ExplorerTree;
                return;
            }

            // Arama filtrelemesi yapıldığında TreeView kaynağını yenileyin
            var filteredRoot = FilterFolderTree(ExplorerTree.FirstOrDefault(), query);
            DuplicatesTreeView.ItemsSource = filteredRoot != null
                ? new ObservableCollection<FolderNodeModel> { filteredRoot }
                : null;
        }
        private FolderNodeModel? FilterFolderTree(FolderNodeModel? node, string query)
        {
            if (node == null) return null;

            var filteredNode = new FolderNodeModel
            {
                Name = node.Name,
                FullPath = node.FullPath
            };

            foreach (var subFolder in node.SubFolders)
            {
                var matchedSub = FilterFolderTree(subFolder, query);
                if (matchedSub != null && (matchedSub.Files.Any() || matchedSub.SubFolders.Any()))
                {
                    filteredNode.SubFolders.Add(matchedSub);
                }
            }

            foreach (var file in node.Files)
            {
                if (file.FileName.ToLower().Contains(query) || file.FilePath.ToLower().Contains(query))
                {
                    filteredNode.Files.Add(file);
                }
            }

            if (filteredNode.Files.Any() || filteredNode.SubFolders.Any())
            {
                return filteredNode;
            }

            return null;
        }
