            StatusText.Text = "Ready to scan the system drive";
            TotalSizeText.Visibility = Visibility.Collapsed;
        }
 
     
        private async Task RunScanAsync()
        {
            await Dispatcher.InvokeAsync(() =>
            {
                DuplicateFiles.Clear();
                allDuplicates.Clear();
                foundDuplicatePaths.Clear();
            });
         
            foreach (string folder in FolderListBox.Items)
            {
                await Scan(folder);
            }
            await Dispatcher.InvokeAsync(() =>
            {
                DuplicateFiles.Clear();
                foundDuplicatePaths.Clear();
                currentPage = 0;
                LoadNextPage();
                SetupGrouping();
                StatusText.Text = _cts.IsCancellationRequested
                ? $"Scan Canceled. Found {allDuplicates.Count} duplicate files."
                : $"Scan Complete. Found {allDuplicates.Count} duplicate files.";
            });
        }

        private async Task Scan(string rootFolderPath)
        {
            _cts?.Cancel();
            _cts = new CancellationTokenSource();
            var token = _cts.Token;
 
            var hashMap = new ConcurrentDictionary<string, string>();   
            var dupPaths = new ConcurrentDictionary<string, byte>();  
            var dupResults = new ConcurrentBag<DuplicateFileModel>();

            int scannedCount = 0;
            int hashedCount = 0;
            long lastUpdateTicks = 0;
            const int updateIntervalMs = 200;

            void MaybeReportStatus(string currentFile, string phase)
            {
                var now = Environment.TickCount64;
                if (now - Interlocked.Read(ref lastUpdateTicks) < updateIntervalMs) return;
                Interlocked.Exchange(ref lastUpdateTicks, now);
                 
                Dispatcher.BeginInvoke(() =>
                {
                    StatusText.Text = $"{phase}... {scannedCount} files scanned, {dupResults.Count} duplicate files found.";
                    FilesScannedText.Text = currentFile;
                });
            }

            try
            {
                await Task.Run(() =>
                {
            
                    IEnumerable<string> EnumerateAllFiles(string root)
                    {
                        var stack = new Stack<string>();
                        stack.Push(root);
                        while (stack.Count > 0)
                        {
                            token.ThrowIfCancellationRequested();
                            var dir = stack.Pop();

                            string[] subDirs = Array.Empty<string>();
                            string[] filesHere = Array.Empty<string>();
                            try
                            {
                                filesHere = Directory.GetFiles(dir);
                                subDirs = Directory.GetDirectories(dir);
                            }
                            catch {  }

                            foreach (var d in subDirs) stack.Push(d);
                            foreach (var f in filesHere) yield return f;
                        }
                    }

               
                    var sizeGroups = new ConcurrentDictionary<long, ConcurrentBag<string>>();

                    Parallel.ForEach(
                        EnumerateAllFiles(rootFolderPath),
                        new ParallelOptions { MaxDegreeOfParallelism = Environment.ProcessorCount, CancellationToken = token },
                        file =>
                        {
                            long size;
                            try { size = new FileInfo(file).Length; }
                            catch { return; }

                            sizeGroups.GetOrAdd(size, _ => new ConcurrentBag<string>()).Add(file);
                            Interlocked.Increment(ref scannedCount);
                            MaybeReportStatus(file, "Scanning...");
                        });

                    var candidates = sizeGroups.Values.Where(g => g.Count > 1).SelectMany(g => g);

                   
                    Parallel.ForEach(
                        candidates,
                        new ParallelOptions { MaxDegreeOfParallelism = Environment.ProcessorCount, CancellationToken = token },
                        file =>
                        {
                            string hash;
                            long length;
                            try
                            {
                                var fi = new FileInfo(file);
                                length = fi.Length;

                                using var stream = new FileStream(
                                    file, FileMode.Open, FileAccess.Read, FileShare.Read,
                                    bufferSize: 1 << 20, FileOptions.SequentialScan);

                                hash = Convert.ToHexString(SHA256.HashData(stream));
                            }
                            catch { return; }

                        
                            var firstSeen = hashMap.GetOrAdd(hash, file);
                            if (firstSeen != file)
                            {
                                if (dupPaths.TryAdd(firstSeen, 0))
                                {
                                    var origInfo = new FileInfo(firstSeen);
                                    dupResults.Add(new DuplicateFileModel
                                    {
                                        FileName = origInfo.Name,
                                        FilePath = firstSeen,
                                        FileSize = origInfo.Length,
                                        Hash = hash
                                    });
                                }
                                if (dupPaths.TryAdd(file, 0))
                                {
                                    dupResults.Add(new DuplicateFileModel
                                    {
                                        FileName = Path.GetFileName(file),
                                        FilePath = file,
                                        FileSize = length,
                                        Hash = hash
                                    });
                                }
                            }

                            Interlocked.Increment(ref hashedCount);
                            MaybeReportStatus(file, "Hashing");
                        });
                }, token);
                 
                var finalList = dupResults.ToList();
                await Dispatcher.InvokeAsync(() =>
                {
                    allDuplicates.Clear();
                    foreach (var item in finalList) allDuplicates.Add(item);

                    foundDuplicatePaths.Clear();
                    foreach (var p in dupPaths.Keys) foundDuplicatePaths.Add(p);

                    StatusText.Text = $"Scan completed! {allDuplicates.Count} duplicate files found.";
                });
            }
            catch (OperationCanceledException)
            {
                var finalList = dupResults.ToList();
                await Dispatcher.InvokeAsync(() =>
                {
                    allDuplicates.Clear();
                    foreach (var item in finalList) allDuplicates.Add(item);
                    StatusText.Text = $"Scan Canceled {allDuplicates.Count} duplicate files found.";
                });
            }

            try
            {
                var json = JsonConvert.SerializeObject(allDuplicates, Formatting.Indented);
                await File.WriteAllTextAsync(duplicatesFilePath, json);
            }
            catch { }
        }


        private async void LoadExistingDuplicates()
        {
            try
            {
                if (!File.Exists(duplicatesFilePath)) return;

                var json = await File.ReadAllTextAsync(duplicatesFilePath);
                if (string.IsNullOrWhiteSpace(json)) return;

                var loaded = JsonConvert.DeserializeObject<List<DuplicateFileModel>>(json);
                if (loaded == null || loaded.Count == 0) return;

                allDuplicates = loaded;

                DuplicateFiles.Clear();
                foundDuplicatePaths.Clear();
                currentPage = 0;
                LoadNextPage();
                SetupGrouping();

                StatusText.Text = $"Loaded {allDuplicates.Count} previously found duplicate files.";
            }
            catch (Exception ex)
            {
                StatusText.Text = "Could not load previous duplicate data.";
                System.Diagnostics.Debug.WriteLine($"LoadExistingDuplicates error: {ex.Message}");
            }
        }
