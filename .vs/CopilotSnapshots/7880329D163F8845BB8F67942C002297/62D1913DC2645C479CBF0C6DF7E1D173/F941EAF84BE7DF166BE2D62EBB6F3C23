<Window x:Class="Multron_Win_Cleaner.MainWindow"
        xmlns:local="clr-namespace:Multron_Win_Cleaner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Multron Win Cleaner"
        Height="750" Width="1050"
        MinWidth="800" MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"  
        AllowsTransparency="True"
        Visibility="Visible"
        ShowInTaskbar="True"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        FontFamily="Segoe UI Variable">

    <Window.Background>
        <DynamicResource ResourceKey="WindowBackground"/>
    </Window.Background>

    <Window.Resources>
        <!-- Grup Stili -->
        <Style x:Key="ExpanderGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="False" Background="Transparent" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CollectionViewSource x:Key="GroupedProcesses" Source="{Binding FlatLockedFiles}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="FilePath" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Yumuşak Gölgelendirme -->
        <DropShadowEffect x:Key="DropShadowSoft" Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.30" />

        <!-- ========================================== -->
        <!-- YENİ MODERN SCROLLBAR (KAYDIRMA ÇUBUĞU)    -->
        <!-- ========================================== -->
        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" CornerRadius="4" Background="{DynamicResource TextPrimary}" Opacity="0.25" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="thumbBorderH" CornerRadius="4" Background="{DynamicResource TextPrimary}" Opacity="0.25" Margin="0,2,0,2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorderH" Property="Opacity" Value="0.55"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorderH" Property="Opacity" Value="0.80"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Standart Buton Stili -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="0.5" CenterY="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sadece İkon İçeren Üst Buton Stili -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFDC3545" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FF0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF106EBE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Arama Kutusu Stili -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF0078D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yuvarlak Ana Scan Butonu -->
        <Style x:Key="RoundScanButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="65" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Backend Uyumlu Dairesel (Circular) Progress Bar -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Foreground" Value="#FF0078D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="120" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Arka plan halkası (track) -->
                            <Ellipse Stroke="{TemplateBinding Background}" StrokeThickness="12" />
                            <!-- Yüzdelik yayı: UpdateArc bu Path'in Data'sini ayarlar -->
                            <Path x:Name="PART_Indicator"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="12"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="None" />
                            <!-- İndeterminate (Bilinmeyen Süre) Efekti -->
                            <Border x:Name="IndeterminateRoot" Background="Transparent" Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="IndeterminateRotate"/>
                                </Border.RenderTransform>
                                <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="12"
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                         StrokeDashArray="0.5 10" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IndeterminateRoot" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinBoard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndeterminateRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinBoard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch (Dark Mode) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBorder" CornerRadius="12" Background="{DynamicResource ButtonBackground}" BorderBrush="{DynamicResource ButtonForeground}" BorderThickness="1" />
                            <Ellipse x:Name="SwitchKnob" Fill="{DynamicResource ButtonForeground}" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#FF0078D4"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#FF0078D4"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="White"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Show" Click="OpenApp_Click"/>
            <MenuItem Header="Hide" Click="HideApp_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="ExitApp_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- PREMIUM EFEKT: Arka planda hafif yayılan renk (Radial Gradient Glow) ve daha tok koyuluk -->
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid>
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.0,0.0" Center="0.1,0.0" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#0D0078D4" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Ekstra %8 siyah tint ile kontrast ve premium doku artırıldı -->
            <Grid Background="#14000000">

                <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="Multron Win Cleaner" MenuActivation="RightClick" IconSource="pack://application:,,,/MultronWinCleaner;component/Assets/mwc_icon.ico" ContextMenu="{StaticResource TrayMenu}" />

                <local:RotatingCleanIcon x:Name="cleanIcon" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="9998" IsHitTestVisible="False" />

                <!-- YÜKLEME EKRANI (Overlay ve Yeni Animasyonlar eklendi) -->
                <Grid x:Name="LoadingOverlay" Background="{DynamicResource WindowBackground}" Panel.ZIndex="9999" Visibility="Visible" MouseLeftButtonDown="LoadingOverlay_MouseLeftButtonDown">
                    <Grid Background="#14000000">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- DÖNEN LOGO ANİMASYONU -->
                            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="80" Height="80" Margin="0,0,0,30" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="SpinnerTransform" Angle="0" />
                                </Image.RenderTransform>
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                </Image.Effect>
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Image.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>

                            <!-- NEFES ALAN YÜKLENİYOR YAZISI -->
                            <TextBlock Name="StatusLoad" Text="Loading, please wait..." Foreground="{DynamicResource TextPrimary}" FontSize="16" Margin="0,20,0,0" HorizontalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.4" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ANA YERLEŞİM -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ÜST MENÜ BARI (Top Bar) -->
                    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" MouseDown="TopBar_MouseDown">
                        <Grid Margin="20,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- YENİ GÜZEL FONT VE DAHA KÜÇÜK BOYUT -->
                                <TextBlock Text="MULTRON WIN CLEANER" FontSize="15" FontFamily="Bahnschrift, Century Gothic, Segoe UI" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Background="#200078D4" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.24 beta" FontSize="11" FontWeight="Bold" Foreground="#FF0078D4" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <ToggleButton x:Name="ToggleThemeSwitch" Style="{StaticResource ToggleSwitchStyle}" Checked="ToggleThemeSwitch_Checked" Unchecked="ToggleThemeSwitch_Unchecked" />
                                    <TextBlock Text="Dark Mode" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>

                                <Button Style="{StaticResource IconButtonStyle}" Click="OpenDiscord_Click" ToolTip="Discord" Margin="0,0,4,0">
                                    <Path Stretch="Uniform" Fill="#5865F2" Width="20" Height="20" Data="M17.5 4.96c-1.33-.6-2.76-1.03-4.26-1.25-.19.34-.4.75-.56 1.12-1.57-.23-3.14-.23-4.69 0-.17-.37-.38-.78-.57-1.12-1.5.22-2.93.65-4.26 1.25C.13 10.63-.4 16.2.22 21.68c1.78 1.3 3.51 2.08 5.23 2.6.43-.58.82-1.19 1.16-1.83-1.68-.62-2.31-1.65-2.31-1.65s.19.12.51.29c.14.07.28.14.41.21.32.14.65.26.98.37 2.1.72 4.31.96 6.55.96 2.23 0 4.45-.24 6.55-.96.33-.11.66-.23.98-.37.14-.07.27-.14.41-.21.32-.17.51-.29.51-.29s-.62 1.03-2.31 1.65c.34.64.73 1.25 1.16 1.83 1.72-.52 3.45-1.3 5.23-2.6.68-6.17-.43-11.64-2.92-16.72zM7.74 17.54c-1.14 0-2.07-1.04-2.07-2.31 0-1.27.92-2.31 2.07-2.31 1.16 0 2.08 1.05 2.07 2.31 0 1.27-.92 2.31-2.07 2.31zm8.52 0c-1.14 0-2.07-1.04-2.07-2.31 0-1.27.92-2.31 2.07-2.31 1.16 0 2.08 1.05 2.07 2.31 0 1.27-.92 2.31-2.07 2.31z" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="OpenGitHub_Click" ToolTip="GitHub" Margin="0,0,4,0">
                                    <Path Stretch="Uniform" Fill="{DynamicResource TextPrimary}" Width="20" Height="20" Data="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </Button>
                                <Button Content="⚙" Style="{StaticResource IconButtonStyle}" Click="OpenSettings_Click" ToolTip="Settings" Margin="0,0,4,0"/>
                                <Button Content="🛠" Style="{StaticResource IconButtonStyle}" Click="UtilitiesButton_Click" ToolTip="Utilities" Margin="0,0,16,0"/>

                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,12,12,12" />
                                <Button Content="─" Style="{StaticResource IconButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                                <Button x:Name="buttonMaximize" Content="⤢" Style="{StaticResource IconButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize/Restore"/>
                                <Button Content="✕" Style="{StaticResource DangerIconButtonStyle}" Click="CloseButton_Click" ToolTip="Close"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- İÇERİK KISMI (Content) -->
                    <Grid Grid.Row="1" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- SOL PANEL KARTI (Glassmorphism Effect) -->
                        <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Effect="{StaticResource DropShadowSoft}">
                            <Border Background="#0C000000" CornerRadius="16" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Scan Bölümü -->
                                    <Grid Grid.Row="0" Margin="0,10,0,0">
                                        <Grid Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="220" Height="220" Stroke="{DynamicResource ButtonBackground}" StrokeThickness="12" />
                                            <Button x:Name="buttonStartScan" Style="{StaticResource RoundScanButtonStyle}" Content="Scan" Click="ButtonStartScan_Click" />
                                        </Grid>
                                    </Grid>

                                    <!-- PROGRESS BAR -->
                                    <ProgressBar Grid.Row="1" x:Name="progressBar1" Minimum="0" Maximum="100" Value="0" Margin="10,24,10,0" Style="{StaticResource ModernProgressBarStyle}" />

                                    <!-- Durum Metni -->
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,16,10,0">
                                        <TextBlock x:Name="label1_Copy" Text="Ready to scan" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" />
                                    </ScrollViewer>

                                    <!-- Alt Butonlar -->
                                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,20,0,0">
                                        <Button x:Name="ButtonLockedFiles" Style="{StaticResource ResetButtonStyle}" Padding="0,14" FontSize="15" Content="🔒 Show Locked Files" Click="ButtonLocked_Click" Visibility="Hidden" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                                        <Button x:Name="buttonReset" Style="{StaticResource ModernButtonStyle}" Padding="0,14" FontSize="15" Content="🔄 Reset" Click="ButtonReset_Click" Visibility="Hidden" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- SAĞ PANEL KARTI (Glassmorphism Effect) -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" Margin="20,0,0,0" Effect="{StaticResource DropShadowSoft}">
                            <Border Background="#0C000000" CornerRadius="16" Padding="24">
                                <Grid x:Name="Panel">

                                    <!-- 1. KİLİTLİ DOSYALAR (Locked Files View) -->
                                    <Grid Background="{DynamicResource PanelBackground}" Panel.ZIndex="10">
                                        <Border Background="#0C000000" Margin="-24" Padding="24" CornerRadius="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Locked Files" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,8" />
                                                <TextBlock Text="These files are currently locked by other processes. Be careful when selecting." Grid.Row="1" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,24" />

                                                <Grid Grid.Row="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
                                                        <Grid Margin="0,0,16,0">
                                                            <TextBox Name="ProcessBox" Style="{StaticResource ModernTextBoxStyle}" Width="220" TextChanged="ProcessBox_TextChanged" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Name="SearchPText" Text="Search Process..." IsHitTestVisible="False" Foreground="Gray" Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text.Length, ElementName=ProcessBox}" Value="0">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Grid>
                                                            <TextBox Name="SearchBox" Style="{StaticResource ModernTextBoxStyle}" Width="220" TextChanged="SearchBox_TextChanged" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Name="SearchText" Text="Search File Or Group..." IsHitTestVisible="False" Foreground="Gray" Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </StackPanel>

                                                    <ScrollViewer Grid.Row="1" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MainScrollViewer_ScrollChanged">
                                                        <ListBox x:Name="listBoxProcesses" Background="Transparent" BorderThickness="0" ItemContainerStyle="{x:Null}">
                                                            <ListBox.GroupStyle>
                                                                <GroupStyle ContainerStyle="{StaticResource ExpanderGroupStyle}" />
                                                            </ListBox.GroupStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource SecondaryPanelBackground}" CornerRadius="6" Padding="12,8" Margin="0,4">
                                                                        <Border Background="#08000000" CornerRadius="6" Margin="-12,-8" Padding="12,8">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 2. DIRECTORY VIEW -->
                                    <ScrollViewer x:Name="ScrollViewerDirectories" Panel.ZIndex="100" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource PanelBackground}">
                                        <Border Background="#0C000000" Margin="-24" Padding="24" CornerRadius="16">
                                            <StackPanel x:Name="wrapPanelDirectories" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        </Border>
                                    </ScrollViewer>

                                    <!-- 3. DATAGRID VIEW -->
                                    <Grid Name="Datagridscroll" Panel.ZIndex="101" Visibility="Collapsed" Background="{DynamicResource PanelBackground}">
                                        <Border Background="#0C000000" Margin="-24" Padding="24" CornerRadius="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                                    <Label Content="Search for directory:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextForeground}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Grid Margin="0,0,16,0">
                                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
                                                    </Grid>
                                                    <Button Content="Select All" Click="SelectAll_AllGroups_Click" Style="{StaticResource ModernButtonStyle}" Background="#FF0078D4" Foreground="White" Margin="0,0,8,0" />
                                                    <Button Content="Unselect All" Click="UnselectAll_AllGroups_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" />
                                                </StackPanel>

                                                <DataGrid Grid.Row="1" Name="dataGridGroups" ItemsSource="{Binding Groups}" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" IsReadOnly="True" HeadersVisibility="Column" RowDetailsVisibilityMode="Visible" AutoGenerateColumns="False" Foreground="{DynamicResource TextForeground}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Visibility="Collapsed" />
                                                    </DataGrid.Columns>
                                                    <DataGrid.RowDetailsTemplate>
                                                        <DataTemplate>
                                                            <Expander IsExpanded="False" Background="Transparent" Foreground="{DynamicResource TextForeground}" Header="{Binding ExpanderHeader}">
                                                                <StackPanel Margin="16,8">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                        <Button Content="Select All" Click="SelectAll_Click" Tag="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="#FF0078D4" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
                                                                        <Button Content="Unselect All" Click="UnselectAll_Click" Tag="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Padding="12,6"/>
                                                                    </StackPanel>
                                                                    <ScrollViewer Name="ListBoxScroll" Height="180" Background="Transparent" ScrollChanged="FilesListBox_ScrollChanged">
                                                                        <ListBox ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,4" Foreground="{DynamicResource TextForeground}" Checked="CheckBox2_Checked" Unchecked="CheckBox2_Unchecked">
                                                                                        <CheckBox.ContextMenu>
                                                                                            <ContextMenu>
                                                                                                <MenuItem Header="Open file location" Click="OpenFileLocation_Click"/>
                                                                                                <MenuItem Header="Copy path" Click="CopyPath_Click"/>
                                                                                            </ContextMenu>
                                                                                        </CheckBox.ContextMenu>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </DataGrid.RowDetailsTemplate>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 4. TESPİT EDİLEN DOSYALAR -->
                                    <Grid x:Name="ScrollViewerDetectedFiles" Panel.ZIndex="5" Visibility="Visible" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <WrapPanel Grid.Row="0" Margin="0,0,0,20">
                                            <Button x:Name="SlctAll" Content="Select All" Click="SelectAll_wpanel_Click" Style="{StaticResource ModernButtonStyle}" Background="#FF0078D4" Foreground="White" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="UnScl" Content="Unselect All" Click="UnselectAll_wpanel_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="SaveSettings" Content="Save Settings to Database" Click="SaveSettings_Click" Style="{StaticResource ModernButtonStyle}" Background="#FF28A745" Foreground="White" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="ReloadDb" Content="Reload Database" Click="ReloadDatabase_Click" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,10" Padding="16,10" />
                                        </WrapPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                                            <StackPanel x:Name="wrapPanel1" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                        </ScrollViewer>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>